# Copia a .env y completa en Supabase → Project Settings → API
# No subas .env a Git (ya está en .gitignore)

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_o_publishable_key

